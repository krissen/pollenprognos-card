{
  "name": "pollenprognos-card",
  "version": "3.1.0",
  "description": "Custom card for Home Assistant showing pollen forecasts",
  "main": "dist/pollenprognos-card.js",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "update-version": "node scripts/update-version.js",
    "prebuild": "npm run update-version",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check-dist-size": "node scripts/check-dist-size.js",
    "check": "sh scripts/check.sh",
    "setup": "sh scripts/setup-dev.sh"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@vitejs/plugin-legacy": "^6.1.1",
    "esbuild": "^0.25.10",
    "eslint": "^10.6.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-lit": "^2.3.1",
    "eslint-plugin-wc": "^3.1.0",
    "prettier": "^3.9.4",
    "rollup": "^4.52.3",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.62.1",
    "vite": "^6.3.5",
    "vitest": "^4.0.18"
  },
  "dependencies": {
    "intl-messageformat": "^10.7.16",
    "lit": "^3.3.3"
  }
}
